{
  "permissions": {
    "allow": [
      "Bash(npm install *)",
      "Bash(npx tsc *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(mkdir -p \"C:/Projeto Atlas/enem/app/learn/[subject]/[topic]/[sessionId]\")"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"C:/Projeto Atlas/enem\" && git add -A && { git diff --cached --quiet || { git commit -m \"chore: auto-sync $(date +%Y-%m-%d)\" && git push origin main; }; } || true",
            "shell": "bash",
            "statusMessage": "Sincronizando com GitHub…",
            "async": true
          }
        ]
      }
    ]
  }
}
